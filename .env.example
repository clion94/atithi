# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe to expose to the browser: access is enforced by row level
# security in the database, never by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
