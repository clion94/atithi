# Copy to .env.local and fill in from Supabase → Project Settings → API.

# Both values are safe to expose to the browser: access is enforced by row level
# security in the database, never by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRET. Server only: it bypasses row level security. Never add a NEXT_PUBLIC_ prefix,
# never commit it. Only needed for adding and managing staff logins on the Team page;
# without it the rest of the app works and the Team page says adding logins isn't set up.
# On Vercel add it as a normal (non-public) environment variable.
SUPABASE_SERVICE_ROLE_KEY=
